          "type": "number",
          "minimum": 0
        },
        "cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "absolute_gap_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "relative_gap_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "best_bound": {
          "type": "integer",
          "minimum": -1152921504606846975,
          "maximum": 1152921504606846975
        },
        "violation_cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        }
      },
      "required": [
        "status",
        "seconds",
        "cost"
      ],
      "additionalProperties": false
    },
    "maxsat": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        },
        "cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "absolute_gap_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "relative_gap_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "best_bound": {
          "type": "integer",
          "minimum": -1152921504606846975,
          "maximum": 1152921504606846975
        },
        "violation_cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        }
      },
      "required": [
        "status",
        "seconds",
        "cost"
      ],
      "additionalProperties": false
    },
    "native_checker": {
      "type": "object",
      "properties": {
